{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#lint": {
      "cache": false
    },
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {
      "cache": false
    },
    "types": {
      "dependsOn": ["^types"]
    },
    "test": {
      "dependsOn": ["^types"]
    },
    "clean": {
      "cache": false
    }
  }
}
